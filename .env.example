# === DATABASE ===
POSTGRES_PASSWORD=change_me_strong_password_2024

# === OLLAMA ===
# qwen2.5:7b  — если RAM 8-12 GB
# qwen2.5:14b — если RAM 16+ GB (лучше качество)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# === ERP МАРКЕТ API ===
ERP_API_URL=https://market.company.ru/api/v1
ERP_API_TOKEN=your_erp_api_token_here
# Интервал синхронизации претензий из ERP (минуты)
ERP_SYNC_INTERVAL_MINUTES=30

# === TELEGRAM BOT ===
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Telegram user_id через запятую — кто имеет доступ к боту
TELEGRAM_ALLOWED_USERS=123456789,987654321
# chat_id куда слать уведомления юристам (группа или личный чат)
TELEGRAM_LEGAL_CHAT_ID=-1001234567890
# chat_id для закупок
TELEGRAM_PROCUREMENT_CHAT_ID=-1009876543210

# === EXCHANGE / EWS ===
# Включить мониторинг почты Exchange (true/false)
EMAIL_ENABLED=false

# SMTP-адрес мониторируемого почтового ящика (в Exchange: properties → email address)
EMAIL_ADDRESS=claims@company.by

# Хост Exchange-сервера (только hostname, без /EWS/...)
# Пример: mail.company.by или exchange.company.local
EMAIL_EWS_HOST=mail.company.by

# Учётная запись для подключения через EWS
# Формат NTLM:  DOMAIN\svc_srm   (рекомендуется — домен большими буквами)
# Формат Basic: svc_srm@company.local
EMAIL_EWS_USER=COMPANY\svc_srm
EMAIL_PASSWORD=service_account_password_here

# Метод аутентификации: ntlm (рекомендуется для on-prem) | basic
EMAIL_AUTH_TYPE=ntlm

# Проверять SSL-сертификат Exchange?
# false — если Exchange использует корпоративный CA или самоподписанный серт.
# true  — если сертификат выдан публичным CA
EMAIL_EWS_VERIFY_SSL=false

# Папка для мониторинга: INBOX или имя подпапки (например: Претензии)
EMAIL_EWS_FOLDER=INBOX

# Интервал опроса Exchange (секунды). Рекомендуется: 60-120
EMAIL_CHECK_INTERVAL_SECONDS=60

# Максимум писем за один опрос (защита при первом запуске с большим архивом)
EMAIL_BATCH_SIZE=20

# === БЕЗОПАСНОСТЬ API ===
API_SECRET_KEY=change_me_random_32_char_string_here
API_TOKEN=internal_api_token_for_bot_access

# === ОБЩЕЕ ===
LOG_LEVEL=INFO
UPLOAD_MAX_SIZE_MB=50
